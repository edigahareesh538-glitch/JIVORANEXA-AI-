# ============================================================
# Trip Agent - Backend Environment Variables
# Copy this file to .env and fill in what you have.
# EVERYTHING has a safe fallback -- the app runs with ZERO keys set.
# ============================================================

# --- AI (trip understanding + image recognition) ---
GEMINI_API_KEY=
# true = use built-in mock responses (no key needed, good for a first run)
# false = use real Gemini calls once GEMINI_API_KEY is set above
USE_MOCK_LLM=true

# --- Database ---
# Leave blank to auto-use a local SQLite file (./trip_agent.db) -- zero
# setup, persists users/trips/expenses/favorites across restarts.
# For Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode)
#   postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# For plain Postgres:
#   postgresql://user:password@localhost:5432/tripagent
DATABASE_URL=
# Deprecated flag from the old mock/session-only store; irrelevant now
# that app/db/database.py always has a working fallback. Keep as false.
USE_MOCK_DB=false

# --- Auth ---
# The app's OWN email/password + guest-mode auth needs ONLY this secret
# (works with zero external accounts). Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Optional: enables "Sign in with Google". Get this from Firebase Console
# -> Project settings -> Service accounts -> Generate new private key.
# Paste the ENTIRE downloaded JSON as ONE LINE here (escape nothing, just
# make sure it's valid single-line JSON, e.g. via `jq -c . key.json`).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# --- External APIs (all optional -- OpenStreetMap/OSRM used as free defaults) ---
# Only needed if you want Google's maps/places instead of the built-in
# free OpenStreetMap + Overpass + OSRM integration (which needs no key).
GOOGLE_MAPS_API_KEY=
# OpenWeatherMap (free tier): https://openweathermap.org/api
OPENWEATHER_API_KEY=
NEWS_API_KEY=

# --- Booking (Priority 1 item #4) ---
# This project ships a SIMULATED booking system on purpose (see README
# "Booking system" section) so a demo never depends on a paid travel API
# or real payments. These are documented for when you're ready to go live:
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
HOTEL_PROVIDER_API_KEY=
TRANSIT_API_KEY=

# --- App ---
CORS_ORIGINS=http://localhost:3000

# --- Phase 17 (Admin Dashboard) ---
# Bootstrap admin email: signing in with this address unlocks admin routes.
ADMIN_BOOTSTRAP_EMAIL=

# --- Phase 9 (Voice) ---
# Default voice conversation language: en | hi | te | ta | kn | ml | bn | mr | gu | es | fr | de
DEFAULT_VOICE_LANGUAGE=en
